"use client";

import { useEffect, useMemo, useState } from "react";
import type { AppState } from "@/components/dashboard/types";
import { loadSovereignValue } from "@/lib/client/sovereign-store";
import { RecommendationIntelligencePanel } from "@/components/seroq/recommendation-intelligence-panel";

type Trial = {
  capturedAt: string;
  targetMentioned: boolean;
  response: string;
  sources: Array<{ url?: string; title?: string }>;
};

type JourneyResult = {
  queryId: string;
  queryText: string;
  tags: string[];
  status: "OBSERVED" | "UNKNOWN";
  validTrials: number;
  failedTrials: number;
  presence: {
    hits: number;
    n: number;
    rate: number;
    confidenceInterval: { low: number; high: number };
  } | null;
  trials: Trial[];
};

type BatchReport = {
  generatedAt: string;
  targetBrand: string;
  instrument?: string;
  sessionStrategy?: string;
  samplesPerJourney: number;
  providerCount?: number;
  attemptedProviderCount?: number;
  unknownObservations?: number;
  basket: Array<{ queryId: string; queryText: string; tags: string[] }>;
  results: JourneyResult[];
  overall: {
    status: "OBSERVED" | "UNKNOWN";
    hits: number;
    n: number;
    rate: number | null;
    confidenceInterval: { low: number; high: number } | null;
  };
  failedJourneyCount: number;
};

function pct(val: number | null | undefined): string {
  if (val === null || val === undefined) return "0.0%";
  return (val * 100).toFixed(1) + "%";
}

function excerpt(val: string, max = 360): string {
  const clean = val.replace(/\s+/g, " ").trim();
  return clean.length <= max ? clean : clean.slice(0, max) + "…";
}

export default function ReportPage() {
  const [state, setState] = useState<AppState | null>(null);
  const [report, setReport] = useState<BatchReport | null>(null);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    let alive = true;
    (async () => {
      const wsId = window.localStorage.getItem("sovereign-active-workspace") ?? "default";
      const storageKey = wsId === "default" ? "sovereign-aeo-tracker-v1" : `sovereign-aeo-tracker-${wsId}`;
      const loaded = await loadSovereignValue<AppState | null>(storageKey, null);
      if (!alive) return;

      const brand = "swenta global";
      setState(loaded ?? ({ brand: { brandName: "Swenta Global", websites: ["www.swentaglobal.com"], industry: "Accounting, Taxation & Finance BPO", description: "Offshore accounting, UK tax compliance, and finance BPO solutions." } } as any));

      const res = await fetch(`/api/seroq/report/latest?brand=${encodeURIComponent(brand)}`, { cache: "no-store" });
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error ?? "No audit report available.");
      if (alive) setReport(data.report);
    })().catch((err) => {
      if (alive) setError(err instanceof Error ? err.message : String(err));
    });

    return () => { alive = false; };
  }, []);

  const strongest = useMemo(() => {
    if (!report) return [];
    return [...report.results].filter((r) => r.presence).sort((a, b) => (b.presence?.rate ?? 0) - (a.presence?.rate ?? 0)).slice(0, 3);
  }, [report]);

  const weakest = useMemo(() => {
    if (!report) return [];
    return [...report.results].filter((r) => r.presence).sort((a, b) => (a.presence?.rate ?? 0) - (b.presence?.rate ?? 0)).slice(0, 3);
  }, [report]);

  if (error) {
    return (
      <main className="min-h-screen bg-[#080a0c] p-8 text-zinc-100 flex items-center justify-center">
        <div className="max-w-lg rounded-2xl border border-red-500/30 bg-red-500/10 p-6 text-center">
          <p className="text-red-400 font-semibold">{error}</p>
        </div>
      </main>
    );
  }

  if (!report) {
    return (
      <main className="min-h-screen bg-[#080a0c] p-8 text-zinc-100 flex items-center justify-center">
        <div className="text-emerald-400 animate-pulse font-mono text-sm tracking-widest">
          COMPUTING SEROQ ALGORITHMIC DOSSIER…
        </div>
      </main>
    );
  }

  const brandName = state?.brand?.brandName ?? "{brandName}";
  const observedJourneys = report.results.filter((r) => r.status === "OBSERVED").length;
  const zeroPresence = report.results.filter((r) => r.presence?.rate === 0).length;

  return (
    <main id="seroq-report-scroll" className="h-screen w-full overflow-y-auto bg-[#080a0c] text-zinc-100 px-4 py-8 sm:px-8 font-sans antialiased">
      {/* GLOBAL PRINT ENHANCER: KEEPS SEROQ LUXURY COLORS IN PDF */}
      <style jsx global>{`
        /* UNLOCK SCROLL ON SCREEN */
        html, body {
          height: 100% !important;
          overflow: hidden !important;
        }
        #seroq-report-scroll {
          scroll-behavior: smooth;
          -webkit-overflow-scrolling: touch;
        }

        /* MULTI-PAGE PRINT STYLES */
        /* PREVENT TABLE BREAKS & GLYPH CORRUPTION */
        table {
          border-collapse: collapse !important;
          width: 100% !important;
        }
        thead {
          display: table-header-group !important;
        }
        tr {
          break-inside: avoid !important;
          page-break-inside: avoid !important;
        }
        td, th {
          break-inside: avoid !important;
          page-break-inside: avoid !important;
          font-variant-numeric: normal !important;
          font-feature-settings: "zero" 0 !important;
        }
        .rate-cell {
          font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
          font-variant-numeric: normal !important;
          font-feature-settings: normal !important;
        }

        @media print {
          @page {
            margin: 10mm 12mm 10mm 12mm;
            size: A4 portrait;
          }
          * {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
          }
          html, body {
            overflow: visible !important;
            height: auto !important;
            background-color: #080a0c !important;
          }
          #seroq-report-scroll, main {
            height: auto !important;
            max-height: none !important;
            overflow: visible !important;
            background-color: #080a0c !important;
            color: #f1f5f9 !important;
          }
          .no-print {
            display: none !important;
          }
          .break-inside-avoid {
            break-inside: avoid !important;
            page-break-inside: avoid !important;
          }
        }
      `}</style>

      {/* FLOATING ACTION BAR */}
      <div className="no-print fixed bottom-6 right-6 z-50 flex items-center gap-3 bg-[#0d1217]/90 backdrop-blur-md border border-white/10 p-2 rounded-2xl shadow-2xl">
        <a href="/dashboard" className="px-4 py-2 rounded-xl text-xs font-semibold text-zinc-300 hover:text-white bg-white/5 border border-white/5 transition">
          ← Action Center
        </a>
        <button
          onClick={() => window.print()}
          className="flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs font-bold bg-emerald-500 hover:bg-emerald-400 text-black shadow-lg shadow-emerald-500/20 transition-all scale-100 hover:scale-[1.02]"
        >
          <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" /></svg>
          Export Executive Audit (PDF)
        </button>
      </div>

      <article className="mx-auto max-w-5xl space-y-12 pb-24">

        {/* HEADER & EMBLEM */}
        <header className="border-b border-white/10 pb-8 pt-4">
