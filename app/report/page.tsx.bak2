            </div>

            <div className="p-5 rounded-2xl border border-white/10 bg-[#0d1217] flex flex-col justify-between">
              <div>
                <div className="text-xs font-mono text-zinc-400 uppercase tracking-wider mb-2">Engine Coverage Breakdown</div>
                <div className="text-sm text-zinc-300 leading-relaxed">
                  Evaluated across clean-context trials on <strong className="text-white">ChatGPT Search (GPT-4o)</strong>, <strong className="text-white">Perplexity Pro (Sonar)</strong>, and <strong className="text-white">Claude 3.5 Sonnet</strong>.
                </div>
              </div>
              <div className="p-3 rounded-xl border border-white/5 bg-white/[0.02] text-xs text-zinc-400 font-mono">
                Key takeaway: Competitor domains are cited more than twice as frequently as your site due to structured use-case documentation.
              </div>
            </div>
          </div>
        </section>

        
        {/* VERBATIM ENGINE PROOF */}
        <section className="break-inside-avoid space-y-4">
          <div className="text-[10px] font-bold uppercase tracking-[0.2em] text-emerald-400 font-mono">VERBATIM ENGINE PROOF</div>
          <h3 className="text-xl font-bold text-white">What Decision-Makers See When They Prompt</h3>

          <div className="space-y-3">
            {report.results.slice(0, 3).map((r) => {
              const trial = r.trials[0];
              if (!trial) return null;
              return (
                <div key={r.queryId} className="p-5 rounded-2xl border border-white/10 bg-[#0c1015]">
