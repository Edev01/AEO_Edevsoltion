            <div className="p-4 rounded-xl border border-white/10 bg-white/[0.02]">
              <div className="text-emerald-400 font-mono text-sm font-bold">04. Seroq Frozen Remeasurement</div>
              <p className="mt-1 text-xs text-zinc-400 leading-relaxed">
                After 14 days, rerun the identical 10-journey basket under sovereign conditions to calculate verified recommendation lift (improved / unchanged).
              </p>
            </div>
          </div>
        </section>

        {/* METHODOLOGY & INTEGRITY */}
