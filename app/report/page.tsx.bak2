              <ul className="space-y-2 text-xs">
                <li className="flex justify-between items-center py-1.5 border-b border-white/5">
                  <span className="rate-cell font-sans font-semibold text-zinc-200">clutch.co (Verified Profiles)</span>
                  <span className="font-bold text-emerald-400">9 Journeys</span>
                </li>
                <li className="flex justify-between items-center py-1.5 border-b border-white/5">
                  <span className="rate-cell font-sans font-semibold text-zinc-200">qxglobalgroup.com (Competitor Assets)</span>
                  <span className="font-bold text-cyan-400">9 Journeys</span>
                </li>
                <li className="flex justify-between items-center py-1.5 border-b border-white/5">
                  <span className="rate-cell font-sans font-semibold text-zinc-200">entigrity.com (Competitor Assets)</span>
                  <span className="font-bold text-cyan-400">5 Journeys</span>
                </li>
                <li className="flex justify-between items-center py-1.5 border-b border-white/5">
                  <span className="rate-cell font-sans font-semibold text-zinc-200">swentaglobal.com (Your Domain)</span>
                  <span className="font-bold text-amber-400">4 Journeys</span>
                </li>
