            <div className="p-5 rounded-2xl border border-white/10 bg-[#0d1217]">
              <div className="text-[11px] font-mono text-zinc-500 uppercase tracking-wider">Total Trials</div>
              <div className="mt-2 text-3xl font-extrabold text-white">{report.overall.n}</div>
              <div className="mt-1 text-[11px] text-zinc-400">{observedJourneys} Buyer Journeys</div>
            </div>
            <div className="p-5 rounded-2xl border border-white/10 bg-[#0d1217]">
              <div className="text-[11px] font-mono text-zinc-500 uppercase tracking-wider">Surface Mention Rate</div>
              <div className="mt-2 text-3xl font-extrabold text-amber-400">{pct(report.overall.rate)}</div>
              <div className="mt-1 text-[11px] text-zinc-500">{report.overall.hits} / {report.overall.n} observations</div>
            </div>
            <div className="p-5 rounded-2xl border border-red-500/30 bg-red-950/20">
              <div className="text-[11px] font-mono text-red-300 uppercase tracking-wider">Primary Recommendation</div>
              <div className="mt-2 text-3xl font-extrabold text-red-400">0.0%</div>
              <div className="mt-1 text-[11px] text-red-300/70">0 of 10 journeys won</div>
            </div>
            <div className="p-5 rounded-2xl border border-white/10 bg-[#0d1217]">
              <div className="text-[11px] font-mono text-zinc-500 uppercase tracking-wider">95% Wilson Interval</div>
              <div className="mt-2 text-2xl font-extrabold text-cyan-400 font-mono">
                {report.overall.confidenceInterval ? `${pct(report.overall.confidenceInterval.low)} - ${pct(report.overall.confidenceInterval.high)}` : "N/A"}
              </div>
              <div className="mt-1 text-[11px] text-zinc-500">Statistically conservative</div>
            </div>
          </div>
        </section>

        {/* BUYER JOURNEY MATRIX */}
        <section className="break-inside-avoid space-y-4">
          <div className="flex items-center justify-between">
            <div>
              <div className="text-[10px] font-bold uppercase tracking-[0.2em] text-emerald-400 font-mono">DECISION MATRIX</div>
              <h3 className="text-xl font-bold text-white mt-1">10 Commercial Buyer Journeys</h3>
            </div>
            <span className="text-xs font-mono text-zinc-400 bg-white/5 px-3 py-1 rounded-lg border border-white/5">
              {zeroPresence} Journeys with 0% Presence
            </span>
          </div>

          <div className="overflow-hidden rounded-2xl border border-white/10 bg-[#0c1015]">
            <table className="w-full text-left text-xs border-collapse">
              <thead>
                <tr className="border-b border-white/10 bg-white/[0.03] text-zinc-400 font-mono text-[10px] uppercase tracking-wider">
                  <th className="py-3 px-4">Buyer Intent Question</th>
                  <th className="py-3 px-3">Stage / Tags</th>
                  <th className="py-3 px-3 text-center">Mention Rate</th>
                  <th className="py-3 px-4 text-right">Recommendation Role</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-white/5">
                {report.results.map((r, i) => {
                  const rate = r.presence?.rate ?? 0;
                  const isWon = rate >= 0.8;
                  const isMixed = rate > 0 && rate < 0.8;
                  return (
                    <tr key={r.queryId} className="hover:bg-white/[0.01] transition-colors">
                      <td className="py-3.5 px-4 font-medium text-zinc-200 max-w-sm">
                        {r.queryText}
                      </td>
                      <td className="py-3.5 px-3">
                        <div className="flex flex-wrap gap-1">
                          {r.tags.slice(0, 2).map((t) => (
                            <span key={t} className="px-1.5 py-0.5 rounded text-[9px] font-mono bg-white/5 text-zinc-400 border border-white/5">
                              {t}
                            </span>
                          ))}
                        </div>
                      </td>
                      <td className="py-3.5 px-3 text-center font-mono font-bold">
                        <span className={isWon ? "text-emerald-400" : isMixed ? "text-amber-400" : "text-zinc-500"}>
                          {r.presence ? `${r.presence.hits}/${r.presence.n} (${pct(rate)})` : "0%"}
                        </span>
                      </td>
                      <td className="py-3.5 px-4 text-right">
                        {rate === 0 ? (
                          <span className="px-2 py-0.5 rounded-full text-[10px] font-bold bg-red-500/10 text-red-400 border border-red-500/20">ABSENT</span>
