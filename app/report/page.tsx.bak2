            <div className="flex items-center gap-3">
              <div className="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-400 flex items-center justify-center shadow-lg shadow-emerald-500/20 font-mono font-black text-black text-lg">
                SQ
              </div>
              <div>
                <div className="flex items-center gap-2">
                  <span className="text-xs font-bold tracking-[0.25em] text-emerald-400 uppercase">SEROQ INTELLIGENCE</span>
                  <span className="text-[10px] px-2 py-0.5 rounded-full bg-emerald-400/10 text-emerald-300 border border-emerald-500/20 font-mono">CONFIDENTIAL</span>
                </div>
                <div className="text-xs text-zinc-500 font-mono">AUTONOMOUS ANSWER-ENGINE DIAGNOSTIC · VERIFIED 2026 AUDIT</div>
              </div>
            </div>
            <div className="text-right font-mono text-xs text-zinc-400">
              <div>TARGET: <span className="text-white font-bold">{brandName}</span></div>
              <div className="text-zinc-500">{new Date(report.generatedAt).toLocaleDateString()} · Point-in-time snapshot</div>
            </div>
          </div>

          <div className="mt-8">
            <h1 className="text-3xl sm:text-5xl font-extrabold tracking-tight text-white leading-tight">
              Algorithmic Recommendation Audit
            </h1>
            <p className="mt-3 text-base sm:text-lg text-emerald-400/90 font-medium">
              Competitive evaluation across 10 high-intent commercial buyer journeys & multi-model answer engines.
            </p>
          </div>
        </header>

        {/* STRATEGIC REVENUE BRIEFING: THE C-LEVEL HOOK */}
        <section className="break-inside-avoid rounded-2xl border border-emerald-500/30 bg-gradient-to-b from-emerald-950/20 via-[#0b0f14] to-[#080a0c] p-6 sm:p-8 relative overflow-hidden shadow-2xl">
          <div className="absolute top-0 right-0 w-96 h-96 bg-emerald-500/5 rounded-full blur-3xl pointer-events-none" />
          
          <div className="text-[11px] font-bold uppercase tracking-[0.2em] text-emerald-400 flex items-center gap-2">
            <span className="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-ping" />
