                    <span>QUERY: "{r.queryText}"</span>
                    <span className={r.presence?.rate === 0 ? "text-red-400 font-bold" : "text-emerald-400 font-bold"}>
                      {r.presence?.rate === 0 ? "TARGET ABSENT" : "TARGET CITED"}
                    </span>
                  </div>
                  <p className="text-sm text-zinc-300 italic leading-relaxed border-l-2 border-emerald-500 pl-4 py-1">
                    "{excerpt(trial.response, 400)}"
