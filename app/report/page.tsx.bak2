                </div>
              );
            })}
          </div>
        </section>


        {/* 30-DAY REMEDIATION BLUEPRINT */}
        <section className="break-inside-avoid rounded-2xl border border-emerald-500/30 bg-[#0c1015] p-6 sm:p-8 space-y-6">
          <div className="text-[10px] font-bold uppercase tracking-[0.2em] text-emerald-400 font-mono">COMMERCIAL ROADMAP</div>
          <h3 className="text-2xl font-bold text-white">The 30-Day Recommendation Parity Sprint</h3>

          <div className="grid sm:grid-cols-2 gap-4">
            <div className="p-4 rounded-xl border border-white/10 bg-white/[0.02]">
              <div className="text-emerald-400 font-mono text-sm font-bold">01. Deploy Dedicated UK Accounting & BPO Pillar</div>
              <p className="mt-1 text-xs text-zinc-400 leading-relaxed">
                Publish a dedicated /services/uk-accounting-bpo page featuring 2 technical case studies with formal CaseStudy and AccountingService and Review schema markup to resolve the indexing gap.
              </p>
            </div>
            <div className="p-4 rounded-xl border border-white/10 bg-white/[0.02]">
              <div className="text-emerald-400 font-mono text-sm font-bold">02. Syndicate Technical Evidence to Clutch & G2</div>
              <p className="mt-1 text-xs text-zinc-400 leading-relaxed">
                Update third-party profiles with specific UK practice outsourcing, corporation tax, and dedicated offshore staffing capabilities to match the authority signals AI search crawlers index.
              </p>
            </div>
            <div className="p-4 rounded-xl border border-white/10 bg-white/[0.02]">
              <div className="text-emerald-400 font-mono text-sm font-bold">03. Capture High-Intent Practice Queries</div>
              <p className="mt-1 text-xs text-zinc-400 leading-relaxed">
                Build dedicated comparison and capability pages targeting high-intent discovery terms (e.g. UK practice year-end accounts & dedicated offshore management accountants) to establish initial AI citation presence.
              </p>
