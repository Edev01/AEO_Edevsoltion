import fs from "node:fs/promises";

import {
  existsSync,
} from "node:fs";

import path from "node:path";

import {
  createHash,
} from "node:crypto";

import {
  execFile,
} from "node:child_process";

import {
  NextRequest,
  NextResponse,
} from "next/server";

import {
  wilson,
} from "@/lib/server/seroq-presence-stats";


export const runtime =
  "nodejs";

export const dynamic =
  "force-dynamic";

export const maxDuration =
  900;


type PromptInput = {
  text: string;
  tags?: string[];
};


type Trial = {
  capturedAt: string;
  targetMentioned: boolean;
  response: string;
  sources: unknown[];
};


type MeasurementFile = {
  generatedAt: string;

  validTrials: number;
  failedTrials: number;

  presence: {
    hits: number;
    n: number;
    rate: number;

    confidenceInterval: {
      level: number;
      method: string;
      low: number;
      high: number;
    };
  };

  trials: Trial[];

  failures: Array<{
    capturedAt: string;
    error: string;
  }>;
};


function normalizeQueryText(
  text: string,
): string {

  return String(
    text ?? "",
  )
    .normalize(
      "NFKC",
    )
    .toLowerCase()
    .replace(
      /\s+/g,
      " ",
    )
    .trim();

}


/*
 * Same identity principle used by aeo-platform:
 *
 * identity belongs to the exact normalized question text,
 * never its array position.
 */
function queryIdFor(
  text: string,
): string | null {

  const normalized =
    normalizeQueryText(
      text,
    );


  if (
    !normalized
  ) {
    return null;
  }


  return (
    "q_" +
    createHash(
      "sha256",
    )
      .update(
        normalized,
        "utf8",
      )
      .digest(
        "hex",
      )
      .slice(
        0,
        12,
      )
  );

}


function runProcess(
  executable: string,
  args: string[],
  cwd: string,
  env: NodeJS.ProcessEnv,
): Promise<{
  stdout: string;
  stderr: string;
}> {

  return new Promise(
    (
      resolve,
      reject,
    ) => {

      execFile(
        executable,
        args,
        {
          cwd,
          env,

          timeout:
            10 * 60 * 1000,

          windowsHide:
            true,

          maxBuffer:
            12 * 1024 * 1024,
        },
        (
          error,
          stdout,
          stderr,
        ) => {

          if (
            error
          ) {

            reject(
              new Error(
                [
                  error.message,
                  stderr,
                  stdout,
                ]
                  .filter(Boolean)
                  .join("\n"),
              ),
            );

            return;

          }


          resolve({
            stdout,
            stderr,
          });

        },
      );

    },
  );

}


function selectBasket(
  prompts: PromptInput[],
  limit: number,
): PromptInput[] {

  const seen =
    new Set<string>();


  const clean =
    prompts
      .map(
        (prompt) => ({
          text:
            String(
              prompt.text ??
              "",
            ).trim(),

          tags:
            Array.isArray(
              prompt.tags,
            )
              ? prompt.tags.filter(
                  (
                    tag,
                  ): tag is string =>
                    typeof tag ===
                    "string",
                )
              : [],
        }),
      )
      .filter(
        (prompt) =>
          prompt.text.length >=
          8,
      )
      .filter(
        (prompt) => {

          const normalized =
            normalizeQueryText(
              prompt.text,
            );


          if (
            seen.has(
              normalized,
            )
          ) {
            return false;
          }


          seen.add(
            normalized,
          );

          return true;

        },
      );


  /*
   * Commercial-high first.
   * Stable sort preserves the original onboarding order
   * inside the same priority.
   */
  clean.sort(
    (
      a,
      b,
    ) => {

      const aHigh =
        a.tags.some(
          (tag) =>
            tag.toLowerCase() ===
            "high",
        )
          ? 1
          : 0;


      const bHigh =
        b.tags.some(
          (tag) =>
            tag.toLowerCase() ===
            "high",
        )
          ? 1
          : 0;


      return (
        bHigh -
        aHigh
      );

    },
  );


  return clean.slice(
    0,
    limit,
  );

}


export async function POST(
  request: NextRequest,
) {

  try {

    const body =
      await request.json();


    const targetBrand =
      typeof body.targetBrand ===
      "string"
        ? body.targetBrand.trim()
        : "";


    const rawPrompts =
      Array.isArray(
        body.prompts,
      )
        ? body.prompts
        : [];


    const requestedLimit =
      Number(
        body.maxJourneys ??
        3,
      );


    const maxJourneys =
      Number.isFinite(
        requestedLimit,
      )
        ? Math.max(
            1,
            Math.min(
              10,
              Math.floor(
                requestedLimit,
              ),
            ),
          )
        : 3;


    if (
      !targetBrand
    ) {

      return NextResponse.json(
        {
          ok:
            false,

          error:
            "Target brand is required.",
        },
        {
          status:
            400,
        },
      );

    }


    const basket =
      selectBasket(
        rawPrompts,
        maxJourneys,
      );


    if (
      basket.length ===
      0
    ) {

      return NextResponse.json(
        {
          ok:
            false,

          error:
            "No buyer journeys are available. Analyze a customer website first.",
        },
        {
          status:
            400,
        },
      );

    }


    const collectorRoot =
      process.env
        .SEROQ_COLLECTOR_ROOT ??
      path.resolve(
        process.cwd(),
        "..",
        "seroq-collector",
      );


    const agentRoot =
      path.join(
        collectorRoot,
        "apps",
        "agent",
      );


    const collectorScript =
      path.join(
        agentRoot,
        "dist",
        "seroq-measure-cli.js",
      );


    if (
      !existsSync(
        collectorScript,
      )
    ) {

      throw new Error(
        "Compiled Seroq measurement worker was not found.",
      );

    }


    const captureDir =
      path.join(
        process.cwd(),
        "seroq-captures",
      );


    await fs.mkdir(
      captureDir,
      {
        recursive:
          true,
      },
    );


    const batchId =
      `batch-${new Date()
        .toISOString()
        .replace(
          /[:.]/g,
          "-",
        )}`;


    const childEnv: NodeJS.ProcessEnv = {
      ...process.env,

      ONEGLANSE_APP_MODE:
        "local",
    };


    const results: Array<{
      queryId: string;
      queryText: string;
      tags: string[];

      status:
        "OBSERVED" |
        "UNKNOWN";

      validTrials: number;
      failedTrials: number;

      presence: MeasurementFile["presence"] | null;

      trials: Trial[];

      failures: MeasurementFile["failures"];

      evidenceFile: string | null;

      error?: string;
    }> = [];


    for (
      const prompt of basket
    ) {

      const queryId =
        queryIdFor(
          prompt.text,
        );


      if (
        !queryId
      ) {
        continue;
      }


      const outputFile =
        path.join(
          captureDir,
          `${batchId}-${queryId}.json`,
        );


      try {

        await runProcess(
          process.execPath,

          [
            collectorScript,

            "--prompt",
            prompt.text,

            "--target",
            targetBrand,

            "--trials",
            "5",

            "--output",
            outputFile,
          ],

          agentRoot,

          childEnv,
        );


        const measurement =
          JSON.parse(
            await fs.readFile(
              outputFile,
              "utf8",
            ),
          ) as MeasurementFile;


        results.push({

          queryId,

          queryText:
            prompt.text,

          tags:
            prompt.tags ??
            [],

          status:
            measurement.validTrials >
            0
              ? "OBSERVED"
              : "UNKNOWN",

          validTrials:
            measurement.validTrials,

          failedTrials:
            measurement.failedTrials,

          presence:
            measurement.validTrials >
            0
              ? measurement.presence
              : null,

          trials:
            measurement.trials ??
            [],

          failures:
            measurement.failures ??
            [],

          evidenceFile:
            path.basename(
              outputFile,
            ),

        });

      }
      catch (
        error
      ) {

        results.push({

          queryId,

          queryText:
            prompt.text,

          tags:
            prompt.tags ??
            [],

          status:
            "UNKNOWN",

          validTrials:
            0,

          failedTrials:
            1,

          presence:
            null,

          trials:
            [],

          failures:
            [],

          evidenceFile:
            null,

          error:
            error instanceof Error
              ? error.message
              : String(
                  error,
                ),

        });

      }

    }


    const measurable =
      results.filter(
        (
          result,
        ) =>
          result.status ===
            "OBSERVED" &&
          result.presence !==
            null,
      );


    const totalHits =
      measurable.reduce(
        (
          total,
          result,
        ) =>
          total +
          (
            result.presence?.hits ??
            0
          ),

        0,
      );


    const totalTrials =
      measurable.reduce(
        (
          total,
          result,
        ) =>
          total +
          (
            result.presence?.n ??
            0
          ),

        0,
      );


    const overall =
      wilson(
        totalHits,
        totalTrials,
      );


    const manifest = {

      schema:
        1,

      batchId,

      generatedAt:
        new Date()
          .toISOString(),

      targetBrand,

      provider:
        "chatgpt",

      instrument:
        "logged-in-consumer-ui",

      samplesPerJourney:
        5,

      queryIdentityRule:
        "sha256(normalized exact question text), first 12 hex characters",

      basket:
        results.map(
          (result) => ({

            queryId:
              result.queryId,

            queryText:
              result.queryText,

            tags:
              result.tags,

          }),
        ),

      results,

      overall: {

        status:
          totalTrials >
          0
            ? "OBSERVED"
            : "UNKNOWN",

        hits:
          totalHits,

        n:
          totalTrials,

        rate:
          totalTrials >
          0
            ? totalHits /
              totalTrials
            : null,

        confidenceInterval:
          totalTrials >
          0
            ? {
                level:
                  0.95,

                method:
                  "Wilson",

                low:
                  overall.low,

                high:
                  overall.high,
              }
            : null,

      },

      failedJourneyCount:
        results.filter(
          (result) =>
            result.status ===
            "UNKNOWN",
        ).length,

    };


    const batchFile =
      path.join(
        captureDir,
        `${batchId}-manifest.json`,
      );


    await fs.writeFile(
      batchFile,

      JSON.stringify(
        manifest,
        null,
        2,
      ),

      "utf8",
    );


    return NextResponse.json({
      ok:
        true,

      ...manifest,

      batchFile:
        path.basename(
          batchFile,
        ),
    });

  }
  catch (
    error
  ) {

    return NextResponse.json(
      {
        ok:
          false,

        error:
          error instanceof Error
            ? error.message
            : String(
                error,
              ),
      },
      {
        status:
          500,
      },
    );

  }

}
